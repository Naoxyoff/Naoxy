<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orbis.sys — Centre de Commandement</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #040508;
            --card-bg: rgba(12, 14, 20, 0.85);
            --card-border: rgba(255, 255, 255, 0.06);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-primary: #8b5cf6;
            --accent-secondary: #3b82f6;
            --accent-glow: rgba(139, 92, 246, 0.15);
            --success: #10b981;
            --danger: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            position: relative;
        }

        .ambient-glow {
            position: absolute;
            width: 700px;
            height: 700px;
            background: radial-gradient(circle, rgba(139, 92, 246, 0.07) 0%, rgba(59, 130, 246, 0.04) 50%, transparent 70%);
            border-radius: 50%;
            top: -150px;
            right: -150px;
            z-index: -1;
            filter: blur(90px);
            pointer-events: none;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px 50px;
            border-bottom: 1px solid var(--card-border);
            backdrop-filter: blur(14px);
            background: rgba(4, 5, 8, 0.9);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-weight: 700;
            font-size: 1.2rem;
            letter-spacing: 0.8px;
            background: linear-gradient(135deg, #ffffff, #a78bfa, #60a5fa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-decoration: none;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .nav-links a:hover, .nav-links a.active {
            color: var(--text-main);
        }

        .user-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--card-border);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.88rem;
        }

        .main-container {
            display: flex;
            flex: 1;
            padding: 40px 50px;
            gap: 35px;
            max-width: 1550px;
            width: 100%;
            margin: 0 auto;
        }

        .sidebar {
            width: 290px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            height: fit-content;
            backdrop-filter: blur(12px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            position: sticky;
            top: 100px;
        }

        .nav-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 1.5px;
            font-weight: 700;
            margin-bottom: 12px;
            padding-left: 4px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 14px;
            border-radius: 14px;
            color: var(--text-muted);
            text-decoration: none;
            transition: all 0.25s ease;
            font-size: 0.92rem;
            font-weight: 500;
            cursor: pointer;
            border: 1px solid transparent;
            background: transparent;
        }

        .menu-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.03);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            border: 1px solid var(--card-border);
        }

        .menu-item:hover {
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.02);
        }

        .menu-item.active {
            background: var(--accent-glow);
            color: var(--text-main);
            border-color: rgba(139, 92, 246, 0.35);
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.12);
        }

        .menu-item.active .menu-icon {
            background: rgba(139, 92, 246, 0.12);
            border-color: var(--accent-primary);
            color: var(--accent-primary);
        }

        .content-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .page-header h1 {
            font-size: 2.2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .section-view {
            display: none;
            flex-direction: column;
            gap: 24px;
        }

        .section-view.active {
            display: flex;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            backdrop-filter: blur(12px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .card h3 {
            color: var(--text-main);
            font-size: 1.05rem;
            font-weight: 600;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group label {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--card-border);
            padding: 14px 16px;
            border-radius: 12px;
            color: var(--text-main);
            font-size: 0.92rem;
            outline: none;
            transition: all 0.2s ease;
            width: 100%;
            cursor: pointer;
        }

        .form-control:focus {
            border-color: var(--accent-primary);
            box-shadow: 0 0 12px var(--accent-glow);
            background: rgba(255, 255, 255, 0.04);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            color: #ffffff;
            border: none;
            padding: 14px 28px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.92rem;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
            width: fit-content;
        }

        .btn-primary:hover {
            opacity: 0.92;
            transform: translateY(-2px);
        }

        #toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: var(--accent-primary);
            color: white;
            padding: 14px 24px;
            border-radius: 12px;
            font-weight: 600;
            box-shadow: 0 10px 30px rgba(139, 92, 246, 0.4);
            display: none;
            z-index: 1000;
        }

        @media (max-width: 1024px) {
            .main-container { flex-direction: column; padding: 20px; }
            .sidebar { width: 100%; position: relative; top: 0; }
            .grid-2 { grid-template-columns: 1fr; }
        }
    </style>

<style>
  select option {
    background-color: #1e1e2f;
    color: #ffffff;
  }
</style>
</head>
<body>

    <div class="ambient-glow"></div>
    <div id="toast">✅ Enregistré avec succès !</div>

    <header>
        <a href="/dashboard" class="logo">ORBIS.SYS</a>
        <div class="nav-links">
            <a href="/">Accueil</a>
            <a href="/dashboard" class="active">Centre de Contrôle</a>
            <div class="user-badge">
                <span style="width: 6px; height: 6px; background-color: var(--success); border-radius: 50%;"></span>
                <span>Connecté</span>
            </div>
            <a href="/auth/logout" style="color: #f87171; font-weight: 600;">Déconnexion</a>
        </div>
    </header>

    <div class="main-container">
        <div class="sidebar">
            <div class="nav-title">Navigation</div>
            <div class="menu-item active" onclick="switchTab('tickets', this)">
                <div class="menu-icon">🎫</div>
                <span>Tickets</span>
            </div>
            <div class="menu-item" onclick="switchTab('logs', this)">
                <div class="menu-icon">📜</div>
                <span>Logs</span>
            </div>
            <div class="menu-item" onclick="switchTab('permissions', this)">
                <div class="menu-icon">🔑</div>
                <span>Permissions</span>
            </div>
            <div class="menu-item" onclick="switchTab('moderation', this)">
                <div class="menu-icon">⚖️</div>
                <span>Modération</span>
            </div>
        </div>

        <div class="content-area">
            <div id="tickets" class="section-view active">
                <div class="page-header">
                    <h1>Gestion des Tickets</h1>
                    <p>Configuration connectée en direct au serveur Discord.</p>
                </div>

                <div class="card">
                    <h3>Publication du Panneau</h3>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Salon de publication (#)</label>
                            <select class="form-control" id="announcement_channel">
                                <% channels.filter(c => c.type === 0).forEach(channel => { %>
                                    <option value="<%= channel.id %>"># <%= channel.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Rôle Staff assigné</label>
                            <select class="form-control" id="staff_role">
                                <% roles.forEach(role => { %>
                                    <option value="<%= role.id %>">@ <%= role.name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <button class="btn-primary" onclick="saveTicketConfig()">Enregistrer & Déployer</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function switchTab(tabId, element) {
            document.querySelectorAll('.section-view').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.menu-item').forEach(el => el.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            element.classList.add('active');
        }

        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            toast.innerText = (isError ? '❌ ' : '✅ ') + message;
            toast.style.background = isError ? 'var(--danger)' : 'var(--accent-primary)';
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 3000);
        }

        async function saveTicketConfig() {
            const channelId = document.getElementById('announcement_channel').value;
            const roleId = document.getElementById('staff_role').value;
            const guildId = window.location.pathname.split('/')[2];

            try {
                const response = await fetch(`/api/guilds/${guildId}/tickets/config`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ channelId, roleId })
                });

                const result = await response.json();
                if (response.ok) {
                    showToast('Configuration enregistrée et panneau déployé sur Discord !');
                } else {
                    showToast(result.error || 'Erreur lors de la sauvegarde', true);
                }
            } catch (err) {
                console.error(err);
                showToast('Erreur de communication avec le serveur', true);
            }
        }
    </script>
</body>
</html>
